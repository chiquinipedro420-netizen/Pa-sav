programa {
  funcao inicio() {
   real n1, n2, total 
   cadeia operacao

escreva(" digite n1 :")
leia(n1)

escreva(" digite n2 :")
leia(n2)


escreva("digite operação")
leia(operacao)


se( operacao == '+'){
total = n1 + n2

escreva(" total é :", total)
}


se(operacao == '-'){
 total = n1 - n2

escreva(" total é :",total)

}

se(operacao == '*'){
total = n1 * n2

escreva("total é :", total)
}

se( operacao == '/'){
 total = n1 / n2
 escreva(" total é :", total)

se( n2 == 0)

escreva("erro")
leia("erro")



}
 













  }
}
