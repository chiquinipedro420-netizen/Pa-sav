programa {
  funcao inicio() {
    inteiro  dia

    escreva("digite numero de 1 a 7 :")
      leia(dia)

      escolha(dia){
        caso 1:
        escreva("Domingo")
        pare
      caso 2: 
      escreva("Segunda")
      pare
      caso 3:
      escreva("Terça")
        pare
      caso 4:
      escreva("Quarta")
      pare
      caso 5:
      escreva("Quinta")
      pare
      caso 6:
      escreva("Sexta")
      pare
      caso 7:
      escreva("Sabado")

      caso 8:
      escreva("Numero invalido")
      pare
  
          }
  }
}
