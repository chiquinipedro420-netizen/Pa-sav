programa {
  funcao inicio() {
    real numero = 0 , tentativas = 0



    faca{
      escreva("Digite um numero positivo (escreva 0 ou numero negativo para sair) :")
      leia(numero)

    se(numero > 0){
      tentativas = tentativas + 1
    }
    }
    enquanto(numero > 0)

    escreva("a quantidade digitada é :",tentativas)

  }
}
