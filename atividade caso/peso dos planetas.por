programa {
  funcao inicio() {
    real peso
    cadeia mercurio, jupiter , venus, marte , saturno, urano

    escreva("Informe peso :")
    leia("peso")

    escolha(peso){
      caso mercurio: peso * 0.37

      caso jupiter: peso * 2.34

      caso venus: peso *0.88

      caso marte: peso * 0.38

      caso urano: peso * 1.17

      caso saturno: peso * 1.15
    }









  }
}
