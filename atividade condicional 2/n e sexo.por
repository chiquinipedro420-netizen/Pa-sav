programa {
  funcao inicio() {

    caracter masculino,m,feminino,f,nda,M,F

    escreva("DIgite m,")
      



    se((m == 1)e (m == M)){
      escreva("é masculino")

    }
    senao
    se((f == 2) e (f == F)){
      escreva("é feminino")


    }
    senao
    se((nda == 3)e (nda == nda)){
      escreva(" é nda")

    }







































  }
}
