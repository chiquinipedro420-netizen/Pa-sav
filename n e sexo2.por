programa {
  funcao inicio() {

    caracter sexo, nda

    escreva("DIgite sexo :")
      leia(sexo)

    se( (sexo == 'm')e(sexo == 'M')){
      escreva("é masculino")

    }
    senao
    se( (sexo == 'F')e (sexo == 'f')){
      escreva("é feminino")


    }
    senao
    se (sexo == nda){
      escreva(" é nda")

    }







































  }
}
