programa {
  funcao inicio() {

    real nota_1 , nota_2 , nota_3 , nota_4, media 
     
   caracter nome

  escreva("informe nome: ")
  leia(nome)

  escreva("digite nota_1: ")
   leia(nota_1)

  escreva("digite nota_2: ")
    leia(nota_2)

   escreva("digite nota_3: ")
    leia(nota_3)

   escreva("digite nota_4: ")
     leia(nota_4)
   
     media = (nota_1 + nota_2 +nota_3 + nota_4 )/4

   se( media > 7){
    
  escreva("aprovado")



   }senao{

se(media < 7)

escreva("não aprovado")



















   }












  }
}
